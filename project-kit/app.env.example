# ============================================================================
# app.env.example -> copy to app.env
# Plain (not secret) env variables that are sent to the Cloud Run service and the
# migrate job at deploy time.
# It works in "add or update only the named variables" mode (--update-env-vars).
# Variables that already exist on the service are not removed.
# ----------------------------------------------------------------------------
# !! Do NOT put passwords / tokens / API keys / DATABASE_URL here !!
#    kit.sh refuses names that CONTAIN any of: KEY PWD PASS PASSWORD SECRET TOKEN SALT AUTH
#    SIGNATURE CREDENTIAL PRIVATE DATABASE_URL (only KEYCLOAK_URL, KEYCLOAK_REALM and
#    KEYCLOAK_CLIENT_ID are allowed although they contain KEY), and values that look like
#    secrets (sk-..., sk_live_..., AIza..., ghp_..., github_pat_..., xox?-..., AKIA...,
#    -----BEGIN ... , JWT eyJ..eyJ.., or any 32+ character base64/hex string).
#    -> store the value with ./kit.sh secrets add <1-5>, then ./kit.sh secrets map ENV_NAME <1-5>.
#    Values are shown masked (KEY=***) in the commands that kit.sh prints.
# Only "KEY=VALUE" lines; a  # comment  after a value (space + #) is ignored.
# !! Do NOT set PORT here (set it in resources.env) !!
# Format: one KEY=VALUE per line
# ============================================================================
NODE_ENV=production
TZ=Asia/Bangkok
LOG_LEVEL=info
# APP_BASE_URL=https://example.com
