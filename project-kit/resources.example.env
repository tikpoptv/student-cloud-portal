# ============================================================================
# resources.example.env  ->  copy to resources.env, then edit the values
#   cp resources.example.env resources.env
# (The zip from the portal already contains a filled project-kit/resources.env;
#  do NOT overwrite it with this example file.)
# You can see all values in the "Team resources" tab of the portal, or convert the
# JSON file that you downloaded:
#   ./project-kit/from-portal-json.sh ~/Downloads/<prefix>-resources.json
#   (the Team resources button downloads <prefix>-resources.json; the older name lab5-<prefix>-handoff.json also works)
# This file must NOT contain passwords or secrets. It has resource names only
# (but still do not commit it to a public git repository).
# Optional: ALLOW_PLAIN=NAME1,NAME2  lets those env names through the secret filter (false positives only; see README)
# Format: one KEY=VALUE per line (no quotation marks).
# ============================================================================

# ---- Required ---------------------------------------------------------------
# Your team prefix (3-10 lowercase letters or digits). If you fill only this one,
# the other values below are guessed from the portal naming rules.
PREFIX=grp01

# ---- From the portal (usually no change needed) -----------------------------
PROJECT_ID=cpe-se-course-2026
REGION=asia-southeast1
# Cloud Run service and migrate job names of your team (usually: <prefix> and <prefix>-migrate)
SERVICE_NAME=grp01
MIGRATE_JOB_NAME=grp01-migrate
# Artifact Registry repo and the image name inside it (usually: <prefix> / <prefix>)
REGISTRY=grp01
IMAGE_NAME=grp01
# Service account that runs your app (usually: <prefix>-runner@<project>.iam.gserviceaccount.com)
RUNTIME_SA=grp01-runner@cpe-se-course-2026.iam.gserviceaccount.com
# Cloud SQL (usually: <project>:<region>:<prefix>-pg)
SQL_CONNECTION_NAME=cpe-se-course-2026:asia-southeast1:grp01-pg

# ---- Set these for your own app ---------------------------------------------
# stack: node | python | java | go | static | custom  (only changes the defaults for PORT, Dockerfile and the migrate examples)
STACK=node
# Port your app listens on (the app must listen on the port from $PORT). Default: 8080
PORT=8080

# ---- Optional ---------------------------------------------------------------
# Size and scaling (credit is shared by the whole course; do not set high values without a reason)
#CPU=1
#MEMORY=512Mi
#MIN_INSTANCES=0
#MAX_INSTANCES=1
# Limits: CPU <= 2, MEMORY <= 2Gi, MAX_INSTANCES 1-3, MIN_INSTANCES must be 0
# (MIN_INSTANCES > 0 only with the flag --allow-min-instances and after the TA agrees).
# Dockerfile and the context folder used to build (defaults: Dockerfile and .)
#DOCKERFILE=Dockerfile
#BUILD_CONTEXT=.
# Migration command that runs in the Cloud Run job (empty = no migration)
# Examples: npx prisma migrate deploy | alembic upgrade head | python manage.py migrate
#MIGRATE_COMMAND=npx prisma migrate deploy
# View used to read logs (usually the same as the prefix)
#LOG_VIEW=grp01
